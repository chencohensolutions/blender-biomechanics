{
    "servers": {
        "blender": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "--python",
                "3.11",
                "blender-mcp"
            ],
            "env": {
                "DISABLE_TELEMETRY": "true",
                "BLENDER_HOST": "localhost",
                "BLENDER_PORT": "9876",
                "UV_PYTHON_PREFERENCE": "only-managed"
            }
        }
    }
}