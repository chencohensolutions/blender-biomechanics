{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Blender: Run Add-on from Source",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\launch_blender.ps1"
            ],
            "windows": {
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            "osx": {
                "command": "/bin/sh",
                "args": [
                    "${workspaceFolder}/tools/launch_blender.sh"
                ],
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Blender: Reload Add-on",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "(Get-Date).ToString('o') | Set-Content -Path '${workspaceFolder}\\tools\\.reload_request'"
            ],
            "osx": {
                "command": "/bin/sh",
                "args": [
                    "-c",
                    "date > \"${workspaceFolder}/tools/.reload_request\""
                ]
            },
            "linux": {
                "command": "/bin/sh",
                "args": [
                    "-c",
                    "date > \"${workspaceFolder}/tools/.reload_request\""
                ]
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Blender: Open Add-on Reload Script",
            "type": "shell",
            "command": "code",
            "args": [
                "--reuse-window",
                "--goto",
                "${workspaceFolder}\\tools\\dev_load.py:1"
            ],
            "osx": {
                "args": [
                    "--reuse-window",
                    "--goto",
                    "${workspaceFolder}/tools/dev_load.py:1"
                ]
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            }
        }
    ]
}