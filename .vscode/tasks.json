{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Blender: Run Add-on from Source",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\launch_blender.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Blender: Open Add-on Reload Script",
            "type": "shell",
            "command": "code",
            "args": [
                "--reuse-window",
                "--goto",
                "${workspaceFolder}\\tools\\dev_load.py:1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            }
        }
    ]
}